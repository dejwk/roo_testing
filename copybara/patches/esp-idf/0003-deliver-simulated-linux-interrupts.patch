+static void prvYieldPendingFromInterruptExit( void )
+{
+    if( ( uxInterruptNesting == 0 ) && ( xYieldPending != pdFALSE ) )
+    {
+        xYieldPending = pdFALSE;
+        vPortYieldFromISR();
+    }
