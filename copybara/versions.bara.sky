"""Pinned upstream revisions used by the framework import workflows.

Use immutable commit IDs here. The human-readable versions document why the
pair was selected, while the commit IDs make imports reproducible even if an
upstream tag is moved.
"""

ARDUINO_ESP32_VERSION = "3.3.11"
ARDUINO_ESP32_REV = "189089bb76e74978dc95abebefdad42b0d421ba9"

# Arduino-ESP32 3.3.11 supports ESP-IDF >=5.3,<6.2. This is the newest stable
# ESP-IDF release in that declared compatibility range.
ESP_IDF_VERSION = "6.0.2"
ESP_IDF_REV = "7101770dc6db2667b3c477cc31365dd1acd6db4e"
